# Backend Environment Variables
# Copy this file to .env for local development

# Server Configuration
PORT=3001
NODE_ENV=development

# OpenAI API Configuration (optional - for AI field mapping)
# Get your API key from https://platform.openai.com/api-keys
# If not provided, the system will use basic field mapping without AI
OPENAI_API_KEY=your-openai-api-key-here

# OpenRouter API Configuration (optional - for LLM-based validation)
# Get your API key from https://openrouter.ai/keys
# If not provided, the system will use traditional validation without LLM
OPENROUTER_API_KEY=your-openrouter-api-key-here
# Optional: Specify the model to use (defaults to anthropic/claude-3.5-sonnet)
# Available models: anthropic/claude-3.5-sonnet, openai/gpt-4o, meta-llama/llama-3.1-70b-instruct, etc.
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
# Optional: Your app URL for OpenRouter analytics
APP_URL=http://localhost:3000

# Database (add your database connection string here)
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# JWT Secret (for authentication)
# JWT_SECRET=your-secret-key-here
